% Geometry
geometry
{
    type FEQuadMesh;
    nex 15;
    ney 15;
    Lx  0.5;
    Ly  0.5;
    mode nodes;
}

% Material
material
{
    type    Thermal;
    Cp      1;
    kappa   0.076;
    rho     1;
}

% Solution field
solution
{
    name    T;
    nDims   1;
    field   T;
}

% Time controls
runTime
{
    startTime   0;
    endTime     2;
    deltaT      0.01;
}

% Numerical solver controls
numerics
{
    maxIt       20;
    tol         1e-5;
}